---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Subscription received | HybridSec" description="Your HybridSec newsletter subscription was received." noindex>
  <section class="container mx-auto px-4 py-20 text-center min-h-[60vh]">
    <h1 class="text-4xl font-heading font-bold text-primary-500 dark:text-white mb-6">You're on the list</h1>
    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
      Thanks for subscribing. Please watch your inbox for future HybridSec updates.
    </p>
    <a href="/" class="inline-flex px-6 py-3 bg-secondary-500 text-white rounded-lg hover:bg-secondary-600">
      Return home
    </a>
  </section>
</Layout>
